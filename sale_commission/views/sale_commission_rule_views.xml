<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_sale_commission_rule_list" model="ir.ui.view">
    <field name="name">sale.commission.rule.list</field>
    <field name="model">sale.commission.rule</field>
    <field name="arch" type="xml">
      <list string="Reglas de comisión">
        <field name="name" />
        <field name="user_id" />
        <field name="commission_percent" string="%" />
        <field name="active" />
      </list>
    </field>
  </record>

  <record id="view_sale_commission_rule_form" model="ir.ui.view">
    <field name="name">sale.commission.rule.form</field>
    <field name="model">sale.commission.rule</field>
    <field name="arch" type="xml">
      <form string="Regla de comisión">
        <sheet>
          <group>
            <group string="Configuración">
              <field name="name" />
              <field name="user_id" />
              <field name="commission_percent" />
              <field name="active" />
            </group>
          </group>
          <notebook>
            <page string="Histórico" name="history">
              <field name="commission_line_ids" readonly="1">
                <list>
                  <field name="order_id" />
                  <field name="amount_total" />
                  <field name="commission_percent" string="%" />
                  <field name="commission_amount" />
                  <field name="state" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_sale_commission_rule" model="ir.actions.act_window">
    <field name="name">Reglas de comisión</field>
    <field name="res_model">sale.commission.rule</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- commission lines list -->
  <record id="view_sale_commission_line_list" model="ir.ui.view">
    <field name="name">sale.commission.line.list</field>
    <field name="model">sale.commission.line</field>
    <field name="arch" type="xml">
      <list
        string="Comisiones"
        decoration-success="state == 'paid'"
        decoration-warning="state == 'draft'"
        decoration-info="state == 'confirmed'"
      >
        <field name="order_id" />
        <field name="user_id" string="Vendedor" />
        <field name="amount_total" string="Base" />
        <field name="commission_percent" string="%" />
        <field name="commission_amount" string="Comisión" />
        <field name="create_date" readonly="1" />
        <field name="state" />
      </list>
    </field>
  </record>

  <record id="action_sale_commission_line" model="ir.actions.act_window">
    <field name="name">Comisiones generadas</field>
    <field name="res_model">sale.commission.line</field>
    <field name="view_mode">list,pivot</field>
  </record>

  <!-- Menus -->
  <menuitem
    id="menu_sale_commission_root"
    name="Comisiones"
    parent="sale.sale_menu_root"
    sequence="50"
  />
  <menuitem
    id="menu_sale_commission_rules"
    name="Reglas"
    parent="menu_sale_commission_root"
    action="action_sale_commission_rule"
    sequence="10"
  />

  <menuitem
    id="menu_sale_commission_lines"
    name="Comisiones generadas"
    parent="menu_sale_commission_root"
    action="action_sale_commission_line"
    sequence="20"
  />
</odoo>
