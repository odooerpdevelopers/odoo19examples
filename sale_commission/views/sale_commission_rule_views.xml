<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- tree View for sale.commission.rule -->
  <record id="view_sale_commission_rule_tree" model="ir.ui.view">
    <field name="name">sale.commission.rule.tree</field>
    <field name="model">sale.commission.rule</field>
    <field name="arch" type="xml">
      <tree string="Reglas de Comisión">
        <field name="user_id" />
        <field name="commission_percent" />
        <field name="active" />
      </tree>
    </field>
  </record>

  <!-- Form View for sale.commission.rule -->
  <record id="view_sale_commission_rule_form" model="ir.ui.view">
    <field name="name">sale.commission.rule.form</field>
    <field name="model">sale.commission.rule</field>
    <field name="arch" type="xml">
      <form string="Regla de Comisión">
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="Nombre..." />
            </h1>
          </div>
          <group>
            <group>
              <field name="user_id" />
              <field name="commission_percent" />
            </group>
            <group>
              <field name="active" />
            </group>
          </group>
          <notebook>
            <page string="Líneas de Comisión">
              <field name="commission_line_ids" readonly="1">
                <tree>
                  <field name="order_id" />
                  <field name="amount_total" />
                  <field name="commission_amount" />
                  <field name="state" />
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Search View for sale.commission.rule -->
  <record id="view_sale_commission_rule_search" model="ir.ui.view">
    <field name="name">sale.commission.rule.search</field>
    <field name="model">sale.commission.rule</field>
    <field name="arch" type="xml">
      <search string="Reglas de Comisión">
        <field name="user_id" />
        <field name="name" />
        <separator />
        <filter name="active" string="Activo" domain="[('active', '=', True)]" />
        <filter name="inactive" string="Inactivo" domain="[('active', '=', False)]" />
      </search>
    </field>
  </record>

  <!-- Action for sale.commission.rule -->
  <record id="action_sale_commission_rule" model="ir.actions.act_window">
    <field name="name">Reglas de Comisión</field>
    <field name="res_model">sale.commission.rule</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crear una nueva regla de comisión</p>
    </field>
  </record>

  <!-- Menu for sale.commission.rule -->
  <menuitem
    id="menu_sale_commission_rule"
    name="Reglas de Comisión"
    action="action_sale_commission_rule"
    parent="sale.sale_menu_root"
    sequence="30"
  />
</odoo>
