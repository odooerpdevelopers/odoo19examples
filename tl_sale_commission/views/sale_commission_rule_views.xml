<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- List View for Sale Commission Rule -->
  <record id="sale_commission_rule_view_list" model="ir.ui.view">
    <field name="name">sale.commission.rule.list</field>
    <field name="model">sale.commission.rule</field>
    <field name="arch" type="xml">
      <list create="true">
        <field name="name" />
        <field name="user_id" />
        <field name="commission_percent" />
        <field name="active" />
      </list>
    </field>
  </record>

  <!-- Form View for Sale Commission Rule -->
  <record id="sale_commission_rule_view_form" model="ir.ui.view">
    <field name="name">sale.commission.rule.form</field>
    <field name="model">sale.commission.rule</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name" />
            <field name="user_id" />
            <field name="commission_percent" />
            <field name="active" />
          </group>
          <notebook>
            <page string="Commission Lines">
              <field name="commission_line_ids" nolabel="1">
                <list>
                  <field name="order_id" />
                  <field name="commission_percent" />
                  <field name="commission_amount" />
                  <field name="state" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- List View for Sale Commission Line -->
  <record id="sale_commission_line_view_list" model="ir.ui.view">
    <field name="name">sale.commission.line.list</field>
    <field name="model">sale.commission.line</field>
    <field name="arch" type="xml">
      <list
        create="false"
        decoration-success="state == 'paid'"
        decoration-info="state == 'confirmed'"
        decoration-muted="state == 'draft'"
      >
        <field name="order_id" />
        <field name="user_id" />
        <field name="commission_percent" />
        <field name="amount_untaxed" />
        <field name="commission_amount" />
        <field name="state" />
      </list>
    </field>
  </record>

  <!-- Action for Sale Commission Rule -->
  <record id="sale_commission_rule_action" model="ir.actions.act_window">
    <field name="name">Commission Rules</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sale.commission.rule</field>

    <field name="view_mode">list,form</field>
  </record>

  <!-- Action for Sale Commission Line -->
  <record id="sale_commission_line_action" model="ir.actions.act_window">
    <field name="name">Generated Commissions</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sale.commission.line</field>

    <field name="view_mode">list,form,pivot</field>
  </record>

  <!-- Main Menu for Commissions -->
  <menuitem
    id="menu_commissions"
    name="Commissions"
    parent="sale.sale_menu_root"
    sequence="40"
  />

  <!-- Submenu for Commission Rules -->
  <menuitem
    id="menu_commission_rules"
    name="Commission Rules"
    parent="menu_commissions"
    action="sale_commission_rule_action"
    sequence="10"
  />

  <!-- Submenu for Generated Commissions -->
  <menuitem
    id="menu_generated_commissions"
    name="Generated Commissions"
    parent="menu_commissions"
    action="sale_commission_line_action"
    sequence="20"
  />
</odoo>
