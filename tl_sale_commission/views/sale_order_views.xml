<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- Inherit Form View for Sale Order -->
  <record id="sale_order_commission_view_form" model="ir.ui.view">
    <field name="name">sale.order.commission.form</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='other_information']" position="after">
        <page name="commission_info" string="Commission">
          <group>
            <group>
              <field name="commission_rule_id" readonly="state == 'sale'" />
              <field name="commission_percent" />
              <field name="commission_amount" />
            </group>
          </group>
          <notebook>
            <page string="Commission Lines">
              <field name="commission_line_ids" nolabel="1">
                <list create="false" delete="false">
                  <field name="rule_id" />
                  <field name="commission_percent" />
                  <field name="amount_untaxed" />
                  <field name="commission_amount" />
                  <field name="state" />
                </list>
              </field>
            </page>
          </notebook>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
