<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="sale_order_commission_view_form" model="ir.ui.view">
    <field name="name">sale.order.commission.form</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='other_information']" position="after">
        <page name="commission_info" string="Commission">
          <group>
            <group>
              <field name="commission_id" readonly="state != 'draft'" />
              <field name="commission_percent" />
              <field name="commission_amount" />
            </group>
          </group>
          <notebook>
            <page string="Commission History">
              <field name="commission_line_ids" nolabel="1">
                <list create="false" delete="false">
                  <field name="commission_id" />
                  <field name="commission_percent" />
                  <field name="amount_untaxed" />
                  <field name="commission_amount" />
                  <field name="state" />
                </list>
              </field>
            </page>
          </notebook>
        </page>
      </xpath>
    </field>
  </record>

  <record id="sale_order_commission_view_list" model="ir.ui.view">
    <field name="name">sale.order.commission.list</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_tree" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='amount_total']" position="after">
        <field name="commission_amount" optional="show" />
      </xpath>
    </field>
  </record>
</odoo>
