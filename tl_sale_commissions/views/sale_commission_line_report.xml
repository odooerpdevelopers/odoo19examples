<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="action_report_commission_line" model="ir.actions.report">
    <field name="name">Commissions Report</field>
    <field name="model">sale.commission.line</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">tl_sale_commissions.commission_line_report</field>
    <field name="report_file">tl_sale_commissions.commission_line_report</field>
    <field name="print_report_name">('Commissions Report - %s' % (time.strftime('%Y-%m-%d')))</field>
    <field name="binding_model_id" ref="model_sale_commission_line"/>
    <field name="binding_type">report</field>
  </record>

  <template id="commission_line_report">
    <t t-call="web.html_container">
      <t t-call="web.internal_layout">
        <div class="page">
          <div class="row" style="margin-bottom: 20px;">
            <div class="col-xs-12 text-center">
              <h2>Commissions Report</h2>
              <span t-esc="time.strftime('%Y-%m-%d %H:%M')"/>
            </div>
          </div>

          <t t-foreach="group_data" t-as="group">
            <h3>
              <t t-esc="group['user'].name"/>
            </h3>

            <table class="table table-sm table-bordered" style="margin-bottom: 20px;">
              <thead>
                <tr style="background-color: #f0f0f0;">
                  <th>Order</th>
                  <th>Date</th>
                  <th>Rule</th>
                  <th class="text-right">%</th>
                  <th class="text-right">Untaxed</th>
                  <th class="text-right">Commission</th>
                  <th>State</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="group['lines']" t-as="l">
                  <tr>
                    <td t-esc="l.order_id.name"/>
                    <td>
                      <span t-esc="l.order_id.date_order
                        and l.order_id.date_order.strftime('%Y-%m-%d')
                        or ''"/>
                    </td>
                    <td t-esc="l.commission_id.name"/>
                    <td class="text-right">
                      <t t-esc="'%.2f' % l.commission_percent"/>%
                    </td>
                    <td class="text-right">
                      <span t-esc="'%s %.2f' % ((l.currency_id.symbol or ''), l.amount_untaxed)"/>
                    </td>
                    <td class="text-right">
                      <span t-esc="'%s %.2f' % ((l.currency_id.symbol or ''), l.commission_amount)"/>
                    </td>
                    <td t-esc="l.state"/>
                  </tr>
                </t>
              </tbody>
              <tfoot>
                <tr style="font-weight: bold; background-color: #f9f9f9;">
                  <td colspan="4">Subtotal</td>
                  <td class="text-right">
                    <span t-esc="'%s %.2f' % ((group['lines'][0].currency_id.symbol or ''), group['total_untaxed'])"/>
                  </td>
                  <td class="text-right">
                    <span t-esc="'%s %.2f' % ((group['lines'][0].currency_id.symbol or ''), group['total_commission'])"/>
                  </td>
                  <td/>
                </tr>
              </tfoot>
            </table>
          </t>

          <div style="page-break-before: avoid;">
            <h3>Summary</h3>
            <table class="table table-sm table-bordered">
              <thead>
                <tr style="background-color: #f0f0f0;">
                  <th>Salesperson</th>
                  <th class="text-right">Lines</th>
                  <th class="text-right">Total Untaxed</th>
                  <th class="text-right">Total Commission</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="group_data" t-as="group">
                  <tr>
                    <td t-esc="group['user'].name"/>
                    <td class="text-right" t-esc="group['count']"/>
                    <td class="text-right">
                      <span t-esc="'%s %.2f' % ((group['lines'][0].currency_id.symbol or ''), group['total_untaxed'])"/>
                    </td>
                    <td class="text-right">
                      <span t-esc="'%s %.2f' % ((group['lines'][0].currency_id.symbol or ''), group['total_commission'])"/>
                    </td>
                  </tr>
                </t>
              </tbody>
              <tfoot>
                <tr style="font-weight: bold; background-color: #f9f9f9;">
                  <td>Grand Total</td>
                  <td class="text-right" t-esc="grand_count"/>
                  <td class="text-right">
                    <span t-esc="'%s %.2f' % ((docs[0].currency_id.symbol or ''), grand_untaxed)"/>
                  </td>
                  <td class="text-right">
                    <span t-esc="'%s %.2f' % ((docs[0].currency_id.symbol or ''), grand_commission)"/>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </t>
    </t>
  </template>
</odoo>
