<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="sale_commission_view_list" model="ir.ui.view">
    <field name="name">sale.commission.list</field>
    <field name="model">sale.commission</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="user_id" />
        <field name="commission_percent" />
        <field name="active" />
      </list>
    </field>
  </record>

  <record id="sale_commission_view_form" model="ir.ui.view">
    <field name="name">sale.commission.form</field>
    <field name="model">sale.commission</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name" />
            <field name="user_id" />
            <field name="commission_percent" />
            <field name="active" />
          </group>
          <notebook>
            <page string="Commission Lines">
              <field name="commission_line_ids" nolabel="1">
                <list>
                  <field name="order_id" />
                  <field name="commission_percent" />
                  <field name="amount_untaxed" />
                  <field name="commission_amount" />
                  <field name="state" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="sale_commission_action" model="ir.actions.act_window">
    <field name="name">Commission Rules</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sale.commission</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
