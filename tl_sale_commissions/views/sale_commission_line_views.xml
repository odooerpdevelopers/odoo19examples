<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="sale_commission_line_view_list" model="ir.ui.view">
    <field name="name">sale.commission.line.list</field>
    <field name="model">sale.commission.line</field>
    <field name="arch" type="xml">
      <list
        create="false"
        decoration-success="state == 'paid'"
        decoration-info="state == 'confirmed'"
        decoration-muted="state == 'draft'"
      >
        <field name="order_id" />
        <field name="user_id" />
        <field name="commission_percent" />
        <field name="amount_untaxed" />
        <field name="commission_amount" />
        <field name="state" />
      </list>
    </field>
  </record>

  <record id="sale_commission_line_view_form" model="ir.ui.view">
    <field name="name">sale.commission.line.form</field>
    <field name="model">sale.commission.line</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="action_confirm"
            string="Confirm"
            type="object"
            invisible="state != 'draft'"
          />
          <button
            name="action_set_paid"
            string="Set as Paid"
            type="object"
            invisible="state != 'confirmed'"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <group>
            <field name="order_id" />
            <field name="user_id" />
            <field name="commission_percent" />
          </group>
          <group>
            <field name="amount_untaxed" />
            <field name="commission_amount" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="sale_commission_line_action" model="ir.actions.act_window">
    <field name="name">Generated Commissions</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sale.commission.line</field>
    <field name="view_mode">list,form,pivot</field>
  </record>

  <menuitem
    id="menu_commissions"
    name="Commissions"
    parent="sale.sale_menu_root"
    sequence="40"
  />

  <menuitem
    id="menu_commission_rules"
    name="Commission Rules"
    parent="menu_commissions"
    action="sale_commission_action"
    sequence="10"
  />

  <menuitem
    id="menu_generated_commissions"
    name="Generated Commissions"
    parent="menu_commissions"
    action="sale_commission_line_action"
    sequence="20"
  />
</odoo>
